# Stop the desktop (libinput) from using the DualSense / DualShock 4 touchpad as a PC mouse.
# Games and chiaki-ng still read the touchpad through hidraw/SDL, which this does not affect.
ACTION=="add|change", KERNEL=="event[0-9]*", SUBSYSTEM=="input", ATTRS{name}=="*Wireless Controller Touchpad", ENV{LIBINPUT_IGNORE_DEVICE}="1"
